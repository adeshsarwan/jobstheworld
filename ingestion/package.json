{
  "name": "@job-guide-match/ingestion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "jobs:fetch": "node fetch-jobs.js",
    "jobs:fetch:target-markets": "JOB_FETCH_COUNTRIES=NG,ZA,SA JOB_DATE_POSTED=week JOB_QUERY_BATCH_SIZE=20 JOB_QUERY_CONCURRENCY=1 QUERY_THROTTLE_MS=30000 node fetch-jobs.js",
    "jobs:queries:sync": "node src/query-sync.js",
    "jobs:coverage": "node src/coverage-report.js",
