JSEARCH_DAILY_BUDGET=6
JSEARCH_ADMIN_RESERVE=40
JSEARCH_MIN_REFRESH_HOURS=12
JSEARCH_CONCURRENCY=1
JSEARCH_PAGES_PER_REQUEST=1
JSEARCH_AUTOMATIC_RETRIES=0
