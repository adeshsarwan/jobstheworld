# Dedicated production file: /etc/job-guide-match/ingestion.env, owner adesh, mode 0600.
# Supply real credentials interactively; never commit them.
DB_HOST=127.0.0.1
DB_USER=
DB_PASSWORD=
DB_NAME=job_board
RAPIDAPI_KEY=
JOBS_ADMIN_API_KEY=
JSEARCH_REFRESH_ENABLED=false
